# Nur die ausdrücklich vorgesehenen Veröffentlichungsbereiche aufnehmen.
/*
!/.gitignore
!/README.md
!/README.de.md
!/MANUAL.md
!/MANUAL.de.md
!/pyproject.toml
!/LICENSE
!/NOTICE

# Anwendungscode und tatsächlich verwendete Laufzeitressourcen.
!/src/
/src/**
!/src/thonnycontrib/
!/src/thonnycontrib/backend/
!/src/thonnycontrib/backend/thonny_se_*.py
!/src/thonnycontrib/thonny_se/
!/src/thonnycontrib/thonny_se/*.py
!/src/thonnycontrib/thonny_se/locales/
!/src/thonnycontrib/thonny_se/locales/de.json
!/src/thonnycontrib/thonny_se/icons/
!/src/thonnycontrib/thonny_se/icons/*.png
!/src/thonnycontrib/thonny_se/icons/thonny-se-icons.ttf
!/src/thonnycontrib/thonny_se/icons/catalog.json
!/src/thonnycontrib/thonny_se/icons/font-map.json
!/src/thonnycontrib/thonny_se/icons/sources/
!/src/thonnycontrib/thonny_se/icons/sources/*.svg
!/src/thonnycontrib/thonny_se/icons/licenses/
!/src/thonnycontrib/thonny_se/icons/licenses/LICENSE-lucide.txt
!/src/thonnycontrib/thonny_se/notices/
!/src/thonnycontrib/thonny_se/notices/components.json

# Freigegebene Dokumentationsbilder.
!/images/
/images/**
!/images/readme/
!/images/readme/01-structogram.png
!/images/readme/01-structogram-dark.png
!/images/readme/02-uml.png
!/images/readme/02-uml-dark.png
!/images/readme/03-code-model.png
!/images/readme/03-code-model-dark.png
!/images/readme/04-export.png
!/images/readme/05-objects.png
!/images/readme/05-objects-dark.png
!/images/readme/06-thonny.png
!/images/readme/06-thonny-dark.png
!/images/readme/07-cat.png
!/images/manual/
!/images/manual/apply-changes.png
!/images/manual/apply-changes-dark.png
!/images/manual/classes.png
!/images/manual/classes-dark.png
!/images/manual/edit-method.png
!/images/manual/edit-method-dark.png
!/images/manual/export-buttons.png
!/images/manual/export-buttons-dark.png
!/images/manual/export.png
!/images/manual/export-dark.png
!/images/manual/grid-zoom.png
!/images/manual/grid-zoom-dark.png
!/images/manual/objects.png
!/images/manual/objects-dark.png
!/images/manual/one-file.png
!/images/manual/one-file-dark.png
!/images/manual/palette-switch.png
!/images/manual/palette-switch-dark.png
!/images/manual/structogram.png
!/images/manual/structogram-dark.png

# Keine Tests, generierten Python-Reste oder Betriebssystemdateien.
**/test_*.py
**/*_test.py
**/conftest.py
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store

# Manueller Veröffentlichungsablauf.
!/.github/
/.github/**
!/.github/workflows/
!/.github/workflows/publish.yml
